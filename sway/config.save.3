# Para o Sway (isso muda o cursor no fundo e janelas do sistema)
seat seat0 cursor set WinSur-dark-cursors 24

# Para os apps (isso avisa o GTK para usar o mesmo tema)
exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme 'WinSur-dark-cursors'
    gsettings set org.gnome.desktop.interface cursor-size 24
}
