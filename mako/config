# Aparência Geral
font=JetBrains Mono 10
background-color=#1a1b26e6
text-color=#ffffff
border-size=1
border-color=#4c566a
border-radius=5
padding=15

# Tempo para sumir (em milissegundos)
# 5000 = 5 segundos
default-timeout=5000

# Onde a notificação aparece (top-right é o padrão)
anchor=top-right

# Estilo da borda quando a notificação é importante
[urgency=high]
border-color=#ff5555
default-timeout=0

# Faz a notificação aparecer na tela onde o mouse está no momento
output=ovl
